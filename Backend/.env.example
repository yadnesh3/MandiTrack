# Copy this file to .env and fill in your own values.
# Never commit the real .env — it is ignored by git.

# Port the API listens on
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/manditrack
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/manditrack
MONGO_URI=mongodb://127.0.0.1:27017/manditrack

# Secret used to sign JWTs. Use a long random string; the server refuses
# to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Free API key from https://data.gov.in for live Agmarknet mandi
# prices. When this is missing or rejected, the API falls back to the
# officer-maintained prices stored in MongoDB.
DATA_GOV_API_KEY=

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
